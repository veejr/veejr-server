# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
veejr-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/
/priv/static/*-[0-9a-f]*.*
/priv/static/**/*-[0-9a-f]*.*
/priv/static/**/*.gz

# ...but priv/static/vendor holds checked-in runtime libraries, not build
# output. Leaflet's retina assets (marker-icon-2x.png, layers-2x.png) match
# the digest pattern above purely by accident, and dropping them would 404
# the map's marker icons on high-DPI displays.
!/priv/static/vendor/**/*.png
!/priv/static/vendor/*.js
!/priv/static/vendor/*.css
# Re-ignore the digested copies phx.digest writes beside them. A digest suffix
# is 32 hex characters, so requiring eight is enough to tell "-2x.png" (a real
# source file) from "-401d815d….png" (build output).
/priv/static/vendor/**/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.*
/priv/static/vendor/**/*.gz
/priv/static/uploads/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Local environment and production credential files.
.env
.env.*

# Database files
*.db
*.db-*


# Encrypted attachment blobs uploaded at runtime.
/priv/uploads/
/priv/migrations/

# Local-only Claude Code settings.
.claude/settings.local.json
